# Server-side only. Never commit real credentials.
DATABASE_URL=
# Netlify Database supplies NETLIFY_DATABASE_URL automatically in hosted environments.
NETLIFY_DATABASE_URL=

# Single-user v0.1 authentication.
CREDIFY_ACCESS_KEY=
CREDIFY_SESSION_SECRET=

# Future research/model integrations.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-sol
# true keeps background Responses retrievable if the browser is closed.
# OpenAI's standard Responses retention applies when true.
OPENAI_STORE_RESPONSES=true
# Optional: enables live refresh from the private canonical repo.\n# Without it, Credify uses the bundled release only after Git-blob hash verification.\nPROTOCOL_GITHUB_TOKEN=
